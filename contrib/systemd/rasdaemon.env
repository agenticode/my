# Settings of the store for my-fleet-exporter.service: the variables
# rasdaemon takes, as in the environment file rasdaemon is started with.
# Keep this file readable by root only (mode 0600).
#
# A PostgreSQL store:
RASDAEMON_DB_BACKEND=postgresql
RAS_PG_HOST=ras-store.example
RAS_PG_PORT=5432
RAS_PG_DATABASE=rasdaemon
RAS_PG_SCHEMA=rasdaemon
RAS_PG_USER=my_reader
RAS_PG_PASSWORD=change-me
RAS_PG_SSL_MODE=verify-full

# A MySQL or MariaDB store:
# RASDAEMON_DB_BACKEND=mysql
# RAS_MYSQL_HOST=ras-store.example
# RAS_MYSQL_PORT=3306
# RAS_MYSQL_DATABASE=rasdaemon
# RAS_MYSQL_USER=my_reader
# RAS_MYSQL_PASSWORD=change-me
# RAS_MYSQL_USE_SSL=true
