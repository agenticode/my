# MemorY exporter for the host it runs on.
#
#   install -m 0755 my /usr/local/bin/my
#   install -m 0644 my-exporter.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now my-exporter
#
# The service only reads. It runs as a user that exists while it runs and
# owns nothing, with two capabilities: reading files whatever their mode
# (the SMBIOS tables, the journal, the rasdaemon database) and reading the
# kernel log. Everything else is closed to it.

[Unit]
Description=MemorY exporter: memory error findings of this host for Prometheus
Documentation=https://github.com/agenticode/my/blob/main/docs/exporter.md
After=network-online.target rasdaemon.service
Wants=network-online.target

[Service]
# 127.0.0.1 is reachable from this host only. To let a Prometheus server
# on another machine scrape it, name an address of this host, or :10163
# for every interface. The server has no TLS and no authentication.
ExecStart=/usr/local/bin/my serve --metrics --listen 127.0.0.1:10163 --interval 5m
Restart=on-failure
RestartSec=30

DynamicUser=yes
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYSLOG
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYSLOG
NoNewPrivileges=yes

# The file system is read-only for the service. Its ledgers go to a
# temporary directory of its own, which is removed when it stops.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077

# /dev/kmsg is the kernel log of the running boot. On a host with NVIDIA
# GPUs the service runs nvidia-smi, which needs the devices of the driver:
# add "DeviceAllow=char-nvidiactl rw" and "DeviceAllow=char-nvidia-frontend rw".
DevicePolicy=closed
DeviceAllow=/dev/kmsg r

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
