# HELP my_dimm_verdict Finding for the DIMM in the slot: 0 ok, 1 observe, 2 consider replacement, 3 replace now, 4 hold replacement. An empty slot and serial carry the host finding, about errors and page offlines that are tied to no DIMM.
# TYPE my_dimm_verdict gauge
my_dimm_verdict{host="h1",slot="",serial=""} 4
my_dimm_verdict{host="h1",slot="DIMM_A1",serial=""} 3
my_dimm_verdict{host="h1",slot="DIMM_A10",serial=""} 4
my_dimm_verdict{host="h1",slot="DIMM_A2",serial=""} 3
my_dimm_verdict{host="h1",slot="DIMM_A3",serial=""} 3
my_dimm_verdict{host="h1",slot="DIMM_A4",serial=""} 0
my_dimm_verdict{host="h1",slot="DIMM_A5",serial=""} 3
my_dimm_verdict{host="h1",slot="DIMM_A6",serial=""} 3
my_dimm_verdict{host="h1",slot="DIMM_A8",serial=""} 3
my_dimm_verdict{host="h1",slot="DIMM_A9",serial=""} 3
my_dimm_verdict{host="h1",slot="socket1 channel0 dimm0",serial=""} 1
# HELP my_dimm_ce_total Corrected errors on record for the DIMM, counted from error records. An empty serial counts errors of the slot that could not be tied to a DIMM.
# TYPE my_dimm_ce_total counter
my_dimm_ce_total{host="h1",slot="",serial=""} 1
my_dimm_ce_total{host="h1",slot="DIMM_A1",serial=""} 0
