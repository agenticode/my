my_dimm_ce_total{host="h1",slot="DIMM_A8",serial=""} 0
my_dimm_ce_total{host="h1",slot="DIMM_A9",serial=""} 0
my_dimm_ce_total{host="h1",slot="socket1 channel0 dimm0",serial=""} 1
