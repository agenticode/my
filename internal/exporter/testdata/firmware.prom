# HELP my_dimm_faults Faults of the DIMM in the slot by fault mode. A fault is a group of errors with one cause.
# TYPE my_dimm_faults gauge
my_dimm_faults{host="h1",slot="DIMM_A1",mode="undetermined"} 1
my_dimm_faults{host="h1",slot="DIMM_A2",mode="undetermined"} 1
my_dimm_faults{host="h1",slot="DIMM_A3",mode="undetermined"} 1
my_dimm_faults{host="h1",slot="socket1 channel0 dimm0",mode="undetermined"} 1
# HELP my_dimm_offlined_pages Pages of the DIMM in the slot that were taken offline. An empty slot counts pages that are tied to no DIMM.
# TYPE my_dimm_offlined_pages gauge
my_dimm_offlined_pages{host="h1",slot="DIMM_A1"} 0
my_dimm_offlined_pages{host="h1",slot="DIMM_A10"} 0
my_dimm_offlined_pages{host="h1",slot="DIMM_A2"} 0
my_dimm_offlined_pages{host="h1",slot="DIMM_A3"} 0
my_dimm_offlined_pages{host="h1",slot="DIMM_A4"} 0
